{
    "git-guardrails": {
        "enabled": true,
        "PreToolUse": [
            {
                "matcher": "run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "./scripts/git-guardrails.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}