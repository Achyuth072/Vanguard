# Database Connection
DATABASE_URL="file:./pulse.db"

# ==============================================================================
# AI Multi-Level Cascading Inference Engine & Circuit Breaker Configuration
# Multi-key and multi-model comma-separated values are supported for automatic
# intra-key degradation, circular rotation, and 0ms circuit-breaker bypassing.
# ==============================================================================

# Tier 0 & Tier 1: Google Gemini (Primary & Multi-Model Cascade)
# Free tier: 15-30 RPM / 1,500 RPD
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"

# Tier 2: NVIDIA NIM (High Performance Tier - 40 RPM Free)
# https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="z-ai/glm-5.3-flash,z-ai/glm-5.3,stepfun-ai/step-5-preview,deepseek-ai/deepseek-v4.1-flash,Nemotron 3.5 Super VL 120B A12B,moonshotai/kimi-k2.6"

# Tier 3: Ollama Cloud (Hosted Open Models Pool)
# https://api.ollama.com/v1
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://api.ollama.com/v1"
OLLAMA_MODEL="beam,gemma4:31b,gpt-oss:120b,gpt-oss:20b,nemotron-3-nano:30b,nemotron-3-super,nemotron-3-ultra"

# Tier 4 & Tier 6: OpenRouter (Top-Ranked Free Tier & Global Free Router)
# https://openrouter.ai/api/v1
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="inclusionai/ling-3.1-flash,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra:free,nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free"

# Fast Fallback: Groq (Free Tier 30 RPM)
# https://api.groq.com/openai/v1
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Optional standard OpenAI key
OPENAI_API_KEY=""