# Database Connection
DATABASE_URL="file:./pulse.db"

# AI Inference Providers (Zero-Cost Free Tier)
# Multiple comma-separated keys can be specified for automatic circular load balancing and failover

# Groq (Free tier 30 RPM - Llama 3.3 70B / 8B)
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Google AI Studio (Free tier 15 RPM / 1,500 RPD - Gemini 3.7 Flash / 2.5 Flash)
# Comma-separated keys enable circular request rotation and automatic 429 failover
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# OpenRouter (Dynamic Free Model Router)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"

# Optional standard OpenAI key
OPENAI_API_KEY=""